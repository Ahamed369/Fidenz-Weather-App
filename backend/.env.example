# --- OpenWeatherMap ---
OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# --- Server ---
PORT=4000
CACHE_TTL_MS=300000
# Set to "true" while you build the UI so you can skip Auth0 locally.
# Set to "false" (or remove) once Auth0 is wired up, before you submit.
DISABLE_AUTH=true

# --- Auth0 (fill these in once you create your Auth0 tenant) ---
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://weather-comfort-api
